# Convex — set via `bunx convex dev` (creates a deployment and writes these for you)
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Clerk — get these from your Clerk dashboard
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Convex needs Clerk's JWT issuer domain. Find it under Clerk dashboard → JWT Templates → "convex" template → Issuer URL.
# Run `bunx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-app.clerk.accounts.dev` to set on Convex.

# LiveKit — used by Convex action to mint join tokens. Set on Convex with `bunx convex env set ...`
# Get these from your LiveKit Cloud project (or self-hosted server)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
